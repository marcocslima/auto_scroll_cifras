
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regra para a coleção "songs"
    match /songs/{songId} {
      // Permite que qualquer pessoa (autenticada ou não) leia a lista de músicas ou uma música específica.
      // Isso é necessário para que os visitantes do seu site possam ver o conteúdo.
      allow read: if true;

      // Permite a criação, atualização ou exclusão de músicas SOMENTE se o usuário estiver autenticado.
      // A condição "request.auth != null" verifica se o usuário fez login.
      allow write: if request.auth != null;
    }

    // Você pode adicionar outras regras para coleções futuras aqui.
    // Exemplo para uma coleção de usuários:
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
